amily": 2, "groupIds": ["msf-1a-btn-m-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.005Z", "updatedAt": "2026-11-05T00:45:57.005Z", "version": 1}, {"id": "msf-1a-gap0", "type": "text", "x": 23560, "y": 2305, "width": 14, "height": 17.5, "strokeColor": "#e03131", "text": "16", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.005Z", "updatedAt": "2026-11-05T00:45:57.005Z", "version": 1}, {"id": "msf-1a-gap1", "type": "text", "x": 23590, "y": 2530, "width": 21, "height": 17.5, "strokeColor": "#e03131", "text": "100", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.005Z", "updatedAt": "2026-11-05T00:45:57.005Z", "version": 1}, {"id": "msf-1a-gap2", "type": "text", "x": 23300, "y": 2338, "width": 14, "height": 17.5, "strokeColor": "#e03131", "text": "40", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.005Z", "updatedAt": "2026-11-05T00:45:57.005Z", "version": 1}, {"id": "msf-1a-gap3", "type": "text", "x": 23318, "y": 2417, "width": 14, "height": 17.5, "strokeColor": "#e03131", "text": "65", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1a-gap4", "type": "text", "x": 24095, "y": 2562, "width": 14, "height": 17.5, "strokeColor": "#e03131", "text": "24", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1a-gap5", "type": "text", "x": 24095, "y": 2495, "width": 7, "height": 17.5, "strokeColor": "#e03131", "text": "8", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1a-tab", "type": "rectangle", "x": 24480, "y": 2210, "width": 980, "height": 810, "backgroundColor": "#f8f9fa", "strokeColor": "#ced4da", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1a-tab-t", "type": "text", "x": 24504, "y": 2230, "width": 275, "height": 27.5, "strokeColor": "#1e1e1e", "text": "Mesures desktop (étape 1)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1a-tab-b", "type": "text", "x": 24504, "y": 2274, "width": 932, "height": 531.25, "strokeColor": "#343a40", "text": "1   Fond de page Blue 100. Carte 940 × 600 centrée (250, 105), blanche,\n     rayon ≈ 15, ombre douce ; marge intérieure 16.\n2   Barre des étapes 274 × 568, rayon 10, image bg-sidebar-desktop.svg.\n3   4 étapes à (32, 40) dans la barre, une toutes les 65 px.\n     Cercle 33 px, bordure 1 px blanche, chiffre 14 px bold blanc ;\n     étape courante : cercle plein Blue 200, chiffre Blue 950.\n     « STEP 1 » ≈ 12 px, Blue 300 (Q-A5) ; « YOUR INFO » 14 px bold,\n     majuscules, espacement 1 px, blanc ; 16 px après le cercle.\n4   Colonne de contenu 450 px, x 640 → 1090 (100 après la barre).\n5   Titre « Personal info » 32 px bold Blue 950.\n6   Paragraphe 16 px Grey 500 (Q-A1), ≈ 11 sous le titre.\n7   Libellés 14 px Blue 950, ≈ 40 sous le paragraphe.\n8   Champs 450 × 48, rayon 8, bordure 1 px Purple 200 (Q-A3),\n     texte d'exemple 16 px medium Grey 500, 16 de marge ;\n     8 entre libellé et champ, 24 entre champ et libellé suivant.\n     Focus : bordure Purple 600. Erreur : bordure Red 500 et\n     « This field is required » 14 px bold Red 500 à droite du libellé.\n9   « Next Step » 123 × 48, rayon 8, Blue 950, 16 px medium blanc,\n     en bas à droite (bas de la colonne à 32 du bas de la carte) ;\n     survol ≈ #164A8A. « Go Back » : texte 16 px medium Grey 500 à\n     gauche, survol Blue 950 (absent à l'étape 1).\n\nPolice Ubuntu (fichiers fournis) : tailles calées sur la largeur\ndes textes mesurée dans Chromium (écart ≤ 2 %).\nChiffres rouges sur l'image = espacements en px.", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1b-t", "type": "text", "x": 23000, "y": 3090, "width": 880, "height": 27.5, "strokeColor": "#1e1e1e", "text": "1B · Desktop — étapes 2, 3, 4 et remerciement (colonne de contenu, x 600 → 1150)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-b0-t", "type": "text", "x": 23000, "y": 3716, "width": 360, "height": 18.75, "strokeColor": "#495057", "text": "étape 2 · mensuel  (desktop-etape-2-mensuel.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-b1-t", "type": "text", "x": 23590, "y": 3716, "width": 345, "height": 18.75, "strokeColor": "#495057", "text": "étape 2 · annuel  (desktop-etape-2-annuel.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-b2-t", "type": "text", "x": 24180, "y": 3716, "width": 360, "height": 18.75, "strokeColor": "#495057", "text": "étape 3 · options  (desktop-etape-3-mensuel.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-b3-t", "type": "text", "x": 24770, "y": 3716, "width": 405, "height": 18.75, "strokeColor": "#495057", "text": "étape 4 · récapitulatif  (desktop-etape-4-mensuel.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-b4-t", "type": "text", "x": 25360, "y": 3716, "width": 300, "height": 18.75, "strokeColor": "#495057", "text": "remerciement  (desktop-remerciement.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1b-tab", "type": "rectangle", "x": 23000, "y": 3760, "width": 2900, "height": 470, "backgroundColor": "#f8f9fa", "strokeColor": "#ced4da", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1b-tab-t", "type": "text", "x": 23024, "y": 3780, "width": 330, "height": 27.5, "strokeColor": "#1e1e1e", "text": "Mesures desktop (étapes 2 à 5)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1b-tab-b", "type": "text", "x": 23024, "y": 3824, "width": 2852, "height": 233.75, "strokeColor": "#343a40", "text": "Étape 2  Cartes de forfait 138 × 160 (mensuel) ou 138 × 183 (annuel), 18 entre elles, rayon 8, marge 16, bordure Purple 200 ;\n         icône 40 × 40 (icon-arcade / advanced / pro) ; nom 16 px medium Blue 950 en bas ; prix 14 px Grey 500 ; « 2 months free » 12 px Blue 950.\n         Choisie : bordure Purple 600 + fond Blue 50 (Q-A4). Survol : bordure Purple 600.\n         Barre mensuel / annuel 450 × 48, fond Blue 50, rayon 8, 24 sous les cartes ; libellés 14 px medium (actif Blue 950, inactif Grey 500) ;\n         interrupteur 38 × 20 Blue 950, rond blanc 12 px, à gauche = mensuel.\nÉtape 3  Options 450 × 81, 16 entre elles, rayon 8, marge 24, bordure Purple 200 ; case 20 × 20 rayon 4 ; nom 16 px medium Blue 950,\n         description 14 px Grey 500 ; prix « +$1/mo » 14 px Purple 600 à droite. Cochée : case Purple 600 + coche, bordure Purple 600, fond Blue 50.\nÉtape 4  Récapitulatif 450 × ≈ 180, fond Blue 50, rayon 8, marge 24 : « Arcade (Monthly) » 16 px medium Blue 950, « Change » 14 px souligné Grey 500\n         (survol Purple 600), prix 16 px bold Blue 950 ; filet 1 px Purple 200 ; options 14 px Grey 500 avec prix 14 px Blue 950.\n         Total sous la boîte : « Total (per month) » 14 px Grey 500, montant 20 px bold Purple 600. « Confirm » : bouton Purple 600, survol ≈ #928CFF (Q-A6).\nMerci    Bloc centré dans la colonne : icône 80 × 80, « Thank you! » 32 px bold Blue 950, texte 16 px Grey 500 centré, interligne ≈ 25 ; plus de boutons.", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-1c-t", "type": "text", "x": 23000, "y": 4300, "width": 759, "height": 27.5, "strokeColor": "#1e1e1e", "text": "1C · Mobile 375 — étapes 1, 2 (mensuel, annuel), 3, 4 et remerciement", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-m0-t", "type": "text", "x": 23000, "y": 5013, "width": 126, "height": 17.5, "strokeColor": "#495057", "text": "mobile-etape-1.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-m1-t", "type": "text", "x": 23415, "y": 5041, "width": 182, "height": 17.5, "strokeColor": "#495057", "text": "mobile-etape-2-mensuel.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-m2-t", "type": "text", "x": 23830, "y": 5107, "width": 175, "height": 17.5, "strokeColor": "#495057", "text": "mobile-etape-2-annuel.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-m3-t", "type": "text", "x": 24245, "y": 5041, "width": 182, "height": 17.5, "strokeColor": "#495057", "text": "mobile-etape-3-mensuel.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.006Z", "updatedAt": "2026-11-05T00:45:57.006Z", "version": 1}, {"id": "msf-img-m4-t", "type": "text", "x": 24660, "y": 5041, "width": 175, "height": 17.5, "strokeColor": "#495057", "text": "mobile-etape-4-annuel.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-img-m5-t", "type": "text", "x": 25075, "y": 5041, "width": 161, "height": 17.5, "strokeColor": "#495057", "text": "mobile-remerciement.jpg", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-band", "type": "rectangle", "x": 23000, "y": 4340, "width": 375, "height": 172, "backgroundColor": "transparent", "strokeColor": "#e8590c", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-band-m", "type": "ellipse", "x": 23346, "y": 4340, "width": 28, "height": 28, "backgroundColor": "#ffffff", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1c-band-m-g"], "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-band-m-t", "type": "text", "x": 23355.5, "y": 4345, "width": 9, "height": 18, "strokeColor": "#e8590c", "text": "1", "fontSize": 15, "fontFamily": 2, "groupIds": ["msf-1c-band-m-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-circ", "type": "rectangle", "x": 23096, "y": 4370, "width": 184, "height": 37, "backgroundColor": "transparent", "strokeColor": "#c2255c", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-circ-m", "type": "ellipse", "x": 23276, "y": 4374, "width": 28, "height": 28, "backgroundColor": "#ffffff", "strokeColor": "#c2255c", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1c-circ-m-g"], "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-circ-m-t", "type": "text", "x": 23285.5, "y": 4379, "width": 9, "height": 18, "strokeColor": "#c2255c", "text": "2", "fontSize": 15, "fontFamily": 2, "groupIds": ["msf-1c-circ-m-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-card", "type": "rectangle", "x": 23016, "y": 4440, "width": 343, "height": 217, "backgroundColor": "transparent", "strokeColor": "#1971c2", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-card-m", "type": "ellipse", "x": 23346, "y": 4446, "width": 28, "height": 28, "backgroundColor": "#ffffff", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1c-card-m-g"], "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-card-m-t", "type": "text", "x": 23355.5, "y": 4451, "width": 9, "height": 18, "strokeColor": "#1971c2", "text": "3", "fontSize": 15, "fontFamily": 2, "groupIds": ["msf-1c-card-m-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-bar", "type": "rectangle", "x": 23000, "y": 4935, "width": 375, "height": 72, "backgroundColor": "transparent", "strokeColor": "#2f9e44", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.007Z", "updatedAt": "2026-11-05T00:45:57.007Z", "version": 1}, {"id": "msf-1c-bar-m", "type": "ellipse", "x": 23006, "y": 4906, "width": 28, "height": 28, "backgroundColor": "#ffffff", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1c-bar-m-g"], "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.008Z", "updatedAt": "2026-11-05T00:45:57.008Z", "version": 1}, {"id": "msf-1c-bar-m-t", "type": "text", "x": 23015.5, "y": 4911, "width": 9, "height": 18, "strokeColor": "#2f9e44", "text": "4", "fontSize": 15, "fontFamily": 2, "groupIds": ["msf-1c-bar-m-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.008Z", "updatedAt": "2026-11-05T00:45:57.008Z", "version": 1}, {"id": "msf-1c-tab", "type": "rectangle", "x": 25520, "y": 4340, "width": 860, "height": 761, "backgroundColor": "#f8f9fa", "strokeColor": "#ced4da", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.008Z", "updatedAt": "2026-11-05T00:45:57.008Z", "version": 1}, {"id": "msf-1c-tab-t", "type": "text", "x": 25544, "y": 4360, "width": 154, "height": 27.5, "strokeColor": "#1e1e1e", "text": "Mesures mobile", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.008Z", "updatedAt": "2026-11-05T00:45:57.008Z", "version": 1}, {"id": "msf-1c-tab-b", "type": "text", "x": 25544, "y": 4404, "width": 812, "height": 425, "strokeColor": "#343a40", "text": "1   Bandeau 375 × 172 : image bg-sidebar-mobile.svg ;\n     le reste de la page en Blue 100.\n2   4 cercles de 33 px à y = 32, 16 entre eux, centrés ;\n     pas de libellé d'étape en mobile.\n3   Carte blanche 343 de large (16 de chaque côté),\n     à y = 100 (par-dessus le bandeau), rayon 10,\n     marge 24 (32 en haut), ombre douce.\n     Titre 24 px bold ; paragraphe 16 px, interligne 25 ;\n     libellés 12 px ; champs 295 × 40, rayon 4.\n     Forfaits empilés : 295 × ≈ 77 (icône à gauche),\n     12 entre eux ; options 295 × ≈ 62.\n4   Barre blanche 72 px fixée en bas (Q11) :\n     « Next Step » 97 × 40, rayon 4, à 16 du bord droit ;\n     « Go Back » 14 px à 16 du bord gauche ;\n     « Confirm » à l'étape 4 ; pas de barre au remerciement.\n\nIncohérences FM (Q-B1, Q-B2) : étape 2 annuel,\n« Monthly » mis en avant alors que l'interrupteur\nest sur annuel ; étape 4 annuel, « Arcade (Monthly) »\navec un prix en $/yr.", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.008Z", "updatedAt": "2026-11-05T00:45:57.008Z", "version": 1}, {"id": "msf-1d-t", "type": "text", "x": 23000, "y": 5171, "width": 440, "height": 27.5, "strokeColor": "#1e1e1e", "text": "1D · Points de rupture (proposition, Q9)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b0", "type": "rectangle", "x": 23000, "y": 5221, "width": 440, "height": 140, "backgroundColor": "#f3f0ff", "strokeColor": "#6741d9", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1d-b0-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b0-t", "type": "text", "x": 23088.165, "y": 5248.5, "width": 263.66999999999996, "height": 85, "strokeColor": "#6741d9", "text": "Mobile — moins de 768 px\n\nbandeau en haut, carte flottante,\nbarre de boutons fixée en bas", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-1d-b0-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b1", "type": "rectangle", "x": 23000, "y": 5391, "width": 440, "height": 140, "backgroundColor": "#f3f0ff", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1d-b1-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b1-t", "type": "text", "x": 23072.185, "y": 5407.875, "width": 295.63, "height": 106.25, "strokeColor": "#e03131", "text": "Tablette — 768 à 1023 px\n\npas de maquette FM (Q9)\nstructure desktop fluide : barre\nd'étapes plus étroite, colonne souple", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-1d-b1-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b2", "type": "rectangle", "x": 23000, "y": 5561, "width": 440, "height": 140, "backgroundColor": "#f3f0ff", "strokeColor": "#6741d9", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-1d-b2-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1d-b2-t", "type": "text", "x": 23120.125, "y": 5588.5, "width": 199.75, "height": 85, "strokeColor": "#6741d9", "text": "Desktop — 1024 px et plus\n\ncarte 940 × 600 centrée,\nbarre d'étapes 274 px", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-1d-b2-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1e-t", "type": "text", "x": 23520, "y": 5171, "width": 462, "height": 27.5, "strokeColor": "#1e1e1e", "text": "1E · Arbre de composants → HTML sémantique", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1e-box", "type": "rectangle", "x": 23520, "y": 5221, "width": 1180, "height": 560, "backgroundColor": "#ffffff", "strokeColor": "#ced4da", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-1e-b", "type": "text", "x": 23544, "y": 5241, "width": 1140, "height": 240, "strokeColor": "#343a40", "text": "main\n├─ ol            étapes 1 à 4 (aria-current=\"step\" sur l'étape courante), pas de liens (Q4)\n└─ form          novalidate ; une section visible à la fois\n   ├─ section   étape 1 : h1 + p ; 3 × (label + input + message d'erreur relié)\n   ├─ section   étape 2 : fieldset (legend) ; 3 forfaits = input radio + label carte ;\n   │            interrupteur mensuel / annuel (button role=\"switch\" ou input checkbox)\n   ├─ section   étape 3 : fieldset ; 3 options = input checkbox + label ligne\n   ├─ section   étape 4 : récapitulatif (forfait, « Change », options, total)\n   ├─ section   remerciement (annoncé)\n   └─ div       Go Back (button type=button) · Next Step / Confirm (button)\n   + zone aria-live : « Step 2 of 4 » à chaque changement d'étape (Q6)\nfooter          attribution (liens avec survol et focus, leçon R2)", "fontSize": 16, "fontFamily": 3, "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-g2", "type": "text", "x": 23000, "y": 5851, "width": 854, "height": 35, "strokeColor": "#6741d9", "text": "2 · COMPORTEMENT — éléments interactifs, états, accessibilité", "fontSize": 28, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-2a-t", "type": "text", "x": 23000, "y": 5911, "width": 1166, "height": 27.5, "strokeColor": "#1e1e1e", "text": "2A · Inventaire de TOUS les éléments interactifs (règles 1.1.0 et 1.2.0) — normal / survol / focus / actif", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.009Z", "updatedAt": "2026-11-05T00:45:57.009Z", "version": 1}, {"id": "msf-crop0-t", "type": "text", "x": 23000, "y": 6407, "width": 412.5, "height": 18.75, "strokeColor": "#495057", "text": "focus, erreur, survol de Next Step  (etats-etape-1.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-crop1-t", "type": "text", "x": 23530, "y": 6407, "width": 532.5, "height": 18.75, "strokeColor": "#495057", "text": "forfait choisi, forfait survolé, survol de Go Back  (etats-etape-2.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-crop2-t", "type": "text", "x": 24060, "y": 6407, "width": 397.5, "height": 18.75, "strokeColor": "#495057", "text": "options cochées, option survolée  (etats-etape-3.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-crop3-t", "type": "text", "x": 24590, "y": 6407, "width": 382.5, "height": 18.75, "strokeColor": "#495057", "text": "survol de Change et de Confirm  (etats-etape-4.jpg)", "fontSize": 15, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-2a-tab", "type": "rectangle", "x": 23000, "y": 6451, "width": 2900, "height": 560, "backgroundColor": "#f8f9fa", "strokeColor": "#ced4da", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-2a-tab-t", "type": "text", "x": 23024, "y": 6471, "width": 374, "height": 27.5, "strokeColor": "#1e1e1e", "text": "Inventaire (11 groupes d'éléments)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-2a-tab-b", "type": "text", "x": 23024, "y": 6515, "width": 2852, "height": 280, "strokeColor": "#343a40", "text": "  #   Élément                       HTML                          Survol                               Focus clavier       Actif / autre\n  1   Champs Name / Email / Phone   input + label                 bordure Purple 600 (proposition)     bordure + contour   erreur : bordure Red + message\n  2   Next Step                     button                        fond ≈ #164A8A                       contour 2 px        valide l'étape (Q5)\n  3   Go Back                       button type=button            texte Blue 950                       contour 2 px        absent à l'étape 1\n  4   Forfaits (×3)                 input radio + label           bordure Purple 600                   contour 2 px        choisi : bordure + fond Blue 50 (Q-A4) ; flèches du clavier\n  5   Interrupteur mensuel/annuel   switch                        curseur main                         contour 2 px        clic sur les libellés aussi (Q7)\n  6   Options (×3)                  input checkbox + label        bordure Purple 600                   contour 2 px        cochée : case + bordure + fond Blue 50\n  7   Change                        button (lien visuel)          texte Purple 600                     contour 2 px        retour à l'étape 2 (Q10)\n  8   Confirm                       button                        fond plus clair (Q-A6)               contour 2 px        affiche le remerciement (Q8)\n  9   Liens du pied de page (×2)    a                             soulignement retiré (leçon R2)       contour 2 px        —\n  10  Numéros d'étape (×4)          li (non interactif, Q4)       —                                    —                   courant : cercle plein Blue 200\n  11  Messages d'erreur             p relié (aria-describedby)    —                                    —                   annoncés ; effacés dès que le champ est valide\n\nContour de focus partout : 2 px, décalé de 2 px, Purple 600 (ou blanc sur fond foncé) — le focus n'est jamais signalé par la couleur seule.", "fontSize": 16, "fontFamily": 3, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-2b-t", "type": "text", "x": 23000, "y": 7071, "width": 242, "height": 27.5, "strokeColor": "#1e1e1e", "text": "2B · Parcours et états", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-st0", "type": "rectangle", "x": 23000, "y": 7141, "width": 260, "height": 90, "backgroundColor": "#e7f5ff", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-st0-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.010Z", "updatedAt": "2026-11-05T00:45:57.010Z", "version": 1}, {"id": "msf-st0-t", "type": "text", "x": 23102.035, "y": 7164.75, "width": 55.93, "height": 42.5, "strokeColor": "#1971c2", "text": "ÉTAPE 1\ninfos", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-st0-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st1", "type": "rectangle", "x": 23440, "y": 7141, "width": 260, "height": 90, "backgroundColor": "#e7f5ff", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-st1-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st1-t", "type": "text", "x": 23542.035, "y": 7164.75, "width": 55.93, "height": 42.5, "strokeColor": "#1971c2", "text": "ÉTAPE 2\nforfait", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-st1-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st2", "type": "rectangle", "x": 23880, "y": 7141, "width": 260, "height": 90, "backgroundColor": "#e7f5ff", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-st2-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st2-t", "type": "text", "x": 23982.035, "y": 7164.75, "width": 55.93, "height": 42.5, "strokeColor": "#1971c2", "text": "ÉTAPE 3\noptions", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-st2-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st3", "type": "rectangle", "x": 24320, "y": 7141, "width": 260, "height": 90, "backgroundColor": "#e7f5ff", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-st3-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st3-t", "type": "text", "x": 24398.065, "y": 7164.75, "width": 103.86999999999999, "height": 42.5, "strokeColor": "#1971c2", "text": "ÉTAPE 4\nrécapitulatif", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-st3-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st4", "type": "rectangle", "x": 24760, "y": 7141, "width": 260, "height": 90, "backgroundColor": "#ebfbee", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "groupIds": ["msf-st4-g"], "roundness": {"type": 3}, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st4-t", "type": "text", "x": 24870.025, "y": 7175.375, "width": 39.949999999999996, "height": 21.25, "strokeColor": "#2f9e44", "text": "MERCI", "fontSize": 17, "fontFamily": 2, "groupIds": ["msf-st4-g"], "textAlign": "center", "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st0--msf-st1", "type": "arrow", "x": 23268, "y": 7186, "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "points": [[0, 0], [164, 0]], "start": {"id": "msf-st0"}, "end": {"id": "msf-st1"}, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st1--msf-st2", "type": "arrow", "x": 23708, "y": 7186, "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "points": [[0, 0], [164, 0]], "start": {"id": "msf-st1"}, "end": {"id": "msf-st2"}, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st2--msf-st3", "type": "arrow", "x": 24148, "y": 7186, "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "points": [[0, 0], [164, 0]], "start": {"id": "msf-st2"}, "end": {"id": "msf-st3"}, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st3--msf-st4", "type": "arrow", "x": 24588, "y": 7186, "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 0, "points": [[0, 0], [164, 0]], "start": {"id": "msf-st3"}, "end": {"id": "msf-st4"}, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st-l0", "type": "text", "x": 23268, "y": 7097, "width": 112, "height": 35, "strokeColor": "#2f9e44", "text": "Next Step\n3 champs valides", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st-l1", "type": "text", "x": 23708, "y": 7097, "width": 119, "height": 35, "strokeColor": "#2f9e44", "text": "Next Step\nun forfait choisi", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.012Z", "updatedAt": "2026-11-05T00:45:57.012Z", "version": 1}, {"id": "msf-st-l2", "type": "text", "x": 24148, "y": 7097, "width": 63, "height": 17.5, "strokeColor": "#2f9e44", "text": "Next Step", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-l3", "type": "text", "x": 24588, "y": 7097, "width": 49, "height": 17.5, "strokeColor": "#2f9e44", "text": "Confirm", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-back1", "type": "arrow", "x": 23500, "y": 7231, "strokeColor": "#495057", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "points": [[0, 0], [0, 50], [-300, 50], [-300, 0]], "endArrowhead": "arrow", "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-back2", "type": "arrow", "x": 23940, "y": 7231, "strokeColor": "#495057", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "points": [[0, 0], [0, 50], [-300, 50], [-300, 0]], "endArrowhead": "arrow", "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-back3", "type": "arrow", "x": 24380, "y": 7231, "strokeColor": "#495057", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "points": [[0, 0], [0, 50], [-300, 50], [-300, 0]], "endArrowhead": "arrow", "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-back-t", "type": "text", "x": 23270, "y": 7289, "width": 217, "height": 17.5, "strokeColor": "#495057", "text": "Go Back (les choix sont gardés)", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-change", "type": "arrow", "x": 24450, "y": 7231, "strokeColor": "#6741d9", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "points": [[0, 0], [0, 110], [-880, 110], [-880, 0]], "endArrowhead": "arrow", "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-change-t", "type": "text", "x": 23900, "y": 7349, "width": 154, "height": 17.5, "strokeColor": "#6741d9", "text": "Change → étape 2 (Q10)", "fontSize": 14, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-st-misc", "type": "text", "x": 23000, "y": 7401, "width": 2800, "height": 63.75, "strokeColor": "#343a40", "text": "Erreurs : étape 1 (champ vide, email mal formé, téléphone, Q3) ; étape 2 (aucun forfait, Q1). Focus sur le premier champ en erreur ; message effacé dès que c'est valide (Q5).\nChangement d'étape : focus sur le titre de l'étape, « Step N of 4 » annoncé (Q6). Mensuel / annuel : prix des forfaits, des options et du total mis à jour (Q7).\nRemerciement : remplace le formulaire, sans retour (Q8). L'étape 4 reste marquée comme courante dans la barre.", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-2c-t", "type": "text", "x": 23000, "y": 7541, "width": 979, "height": 27.5, "strokeColor": "#1e1e1e", "text": "2C · Accessibilité et contrastes (AA : 4,5:1 texte, 3:1 composants et icônes nécessaires)", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-2c-b", "type": "text", "x": 23000, "y": 7581, "width": 2850, "height": 148.75, "strokeColor": "#343a40", "text": "•  Formulaire : labels reliés, messages d'erreur reliés (aria-describedby) et annoncés, aria-invalid ; forfaits = groupe radio, options = cases à cocher natives.\n•  OK : titres et libellés Blue 950 14,3:1 · Next Step blanc sur Blue 950 14,3:1 · survol 8,8:1 · Confirm blanc sur Purple 600 6,2:1 · total et prix Purple 600 6,0 à 6,2:1\n     · chiffres blancs sur la barre 6,2:1 · étape courante Blue 950 sur Blue 200 10,6:1 · coche blanche sur Purple 600 6,2:1 · bordure choisie Purple 600 6,2:1\n•  Insuffisant : texte Grey 500 2,8:1 (paragraphes, prix, descriptions, Go Back, Change, récapitulatif, texte d'exemple) · message d'erreur Red 500 4,0:1\n     · bordures Purple 200 1,4:1 (champs, cartes, options, case vide) · « STEP 1 » Blue 300 sur la barre 3,4:1 · texte blanc sur le survol de Confirm 2,8:1\n•  Couleur seule : forfait choisi signalé par la seule couleur (bordure + fond) ; focus des champs par la seule couleur de bordure (leçon R3).\n•  Icônes : forfaits et remerciement décoratives (nom en texte) ; coche portée par la case native.", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-2d-box", "type": "rectangle", "x": 22980, "y": 7851, "width": 2940, "height": 400, "backgroundColor": "#fff5f5", "strokeColor": "#e03131", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "fillStyle": "solid", "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-2d-t", "type": "text", "x": 23000, "y": 7871, "width": 748, "height": 27.5, "strokeColor": "#e03131", "text": "2D · Questions pour ta validation — ma proposition entre parenthèses", "fontSize": 22, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}, {"id": "msf-2d-b", "type": "text", "x": 23000, "y": 7915, "width": 2900, "height": 212.5, "strokeColor": "#343a40", "text": "Q-A1  Texte Grey 500 à 2,8:1. (Gris plus foncé pour tout texte gris : hsl(231, 11%, 47%), 5,0:1 sur blanc et 4,8:1 sur Blue 50.)\nQ-A2  Message d'erreur Red 500 à 4,0:1. (Texte en hsl(354, 84%, 48%), 4,9:1 ; la bordure du champ garde Red 500, 4,0:1 ≥ 3.)\nQ-A3  Bordures Purple 200 à 1,4:1. (Bordure hsl(231, 11%, 58%), 3,3:1, pour les champs, cartes, options et case vide.)\nQ-A4  Forfait choisi signalé par la couleur seule. (Bordure de 2 px quand il est choisi, en plus de la couleur et du fond, sans décaler la carte.)\nQ-A5  « STEP 1 » Blue 300 à 3,4:1 sur la barre. (Blue 200, 4,6:1.)\nQ-A6  Survol de Confirm : texte blanc à 2,8:1. (Violet de survol hsl(243, 100%, 68%), 4,5:1, au lieu de ≈ #928CFF.)\nQ-A7  Focus des champs par la couleur seule. (Contour 2 px décalé de 2 px au focus clavier sur tous les éléments, en plus de la bordure.)\nQ-B1  Mobile, étape 2 annuel : « Monthly » mis en avant. (Le libellé en gras suit toujours la période choisie.)\nQ-B2  Mobile, étape 4 annuel : « Arcade (Monthly) » avec un prix en $/yr. (« Arcade (Yearly) ».)\nQ-B3  Total « +$12/mo » en mensuel mais « $120/yr » en annuel. (Pas de « + » sur le total, qui n'est pas un supplément : « $12/mo ».)", "fontSize": 17, "fontFamily": 2, "createdAt": "2026-11-05T00:45:57.013Z", "updatedAt": "2026-11-05T00:45:57.013Z", "version": 1}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {"msf-img-d1-file": {"mimeType": "image/jpeg", "id": "msf-img-d1-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-b0-file": {"mimeType": "image/jpeg", "id": "msf-img-b0-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-b1-file": {"mimeType": "image/jpeg", "id": "msf-img-b1-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-b2-file": {"mimeType": "image/jpeg", "id": "msf-img-b2-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-b3-file": {"mimeType": "image/jpeg", "id": "msf-img-b3-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-b4-file": {"mimeType": "image/jpeg", "id": "msf-img-b4-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m0-file": {"mimeType": "image/jpeg", "id": "msf-img-m0-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m1-file": {"mimeType": "image/jpeg", "id": "msf-img-m1-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m2-file": {"mimeType": "image/jpeg", "id": "msf-img-m2-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m3-file": {"mimeType": "image/jpeg", "id": "msf-img-m3-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m4-file": {"mimeType": "image/jpeg", "id": "msf-img-m4-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-img-m5-file": {"mimeType": "image/jpeg", "id": "msf-img-m5-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-crop0-file": {"mimeType": "image/jpeg", "id": "msf-crop0-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-crop1-file": {"mimeType": "image/jpeg", "id": "msf-crop1-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-crop2-file": {"mimeType": "image/jpeg", "id": "msf-crop2-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}, "msf-crop3-file": {"mimeType": "image/jpeg", "id": "msf-crop3-file", "created": 1793839540653, "dataURL": "data:image/jpeg;base64,"}}}